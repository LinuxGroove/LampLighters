#!/bin/sh
# Ubuntu Core: runs the game fullscreen on Ubuntu Frame's Wayland display.
# Turn it on with: sudo snap set lantern-out kiosk=true
set -e
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" -m 700
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
# Wait for Ubuntu Frame to create its socket.
i=0
while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && [ "$i" -lt 60 ]; do
  sleep 1
  i=$((i + 1))
done
exec "$SNAP/bin/lantern-out" --display-driver wayland "$@"
