#!/bin/sh
# `snap set lantern-out kiosk=true` runs the game as a fullscreen service on
# Ubuntu Frame (Ubuntu Core devices such as handhelds); false turns it off.
set -e
case "$(snapctl get kiosk)" in
  true)
    snapctl start --enable "$SNAP_INSTANCE_NAME.kiosk"
    ;;
  false)
    snapctl stop --disable "$SNAP_INSTANCE_NAME.kiosk"
    ;;
esac
